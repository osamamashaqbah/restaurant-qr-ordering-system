{
  "name": "restaurant-qr-ordering-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "preview:live": "ng serve --host 127.0.0.1 --port 4300 --proxy-config src/proxy.preview.conf.json",
    "build": "ng build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist/restaurant-qr-ordering-web/browser --project-name restaurant-qr-ordering-system --branch main",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@sentry/angular": "^10.73.0",
    "@supabase/supabase-js": "^2.112.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "hono": "^4.13.5",
    "sharp": "^0.35.4"
  }
}
